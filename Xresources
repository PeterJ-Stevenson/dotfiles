URxvt*termName: rxvt-unicode
URxvt.font: xft:Ubuntu Mono:size=14:hintstyle=hintfull,style=regular
URxvt.boldFont: xft:Ubuntu Mono:size=14:hintstyle=hintfull,style=regular
URxvt.italicFont: xft:Ubuntu Mono:saize=14:hintstyle=hintfull,style=regular
URxvt.boldItalicFont: xft:Ubuntu Mono:size=14:hintstyle=hintfull,style=regular
URxvt*scrollBar:                false
URxvt*scrollBar_right:          true
URxvt*scrollColor:              #000000
URxvt.depth:                    32
URxvt.background:               [80]#1B1B1B
URxvt.imLocale:                 en_DK.utf8
URxvt*locale:                   true
URxvt.cursorColor: magenta
URxvt*scrollTtyOutput:  false
URxvt*scrollWithBuffer:  true
URxvt*scrollTtyKeypress: true
URxvt.urgentOnBell:  true
URxvt.saveLines:  200000

URxvt.keysym.Home: \033[1~
URxvt.keysym.End: \033[4~
URxvt.keysym.KP_Home: \033[1~
URxvt.keysym.KP_End:  \033[4~

URxvt.keysym.C-Up:     font-size:increase
URxvt.keysym.C-Down:   font-size:decrease
URxvt.keysym.C-S-Up:   font-size:incglobal
URxvt.keysym.C-S-Down: font-size:decglobal
URxvt.keysym.C-equal:  font-size:reset
URxvt.keysym.C-slash:  font-size:show

URxvt*inheritPixmap: true
URxvt*transparent: true
! URxvt*shading: 0 to 99 darkens, 101 to 200 lightens
