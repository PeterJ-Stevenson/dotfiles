# i3 config file (v4)
# see http://i3wm.org/docs/userguide.html for a complete reference

set $mod Mod4

font pango:monospace 10

# Use Mouse+$mod to drag floating windows
floating_modifier $mod

# Terminal
bindsym $mod+Return exec terminator

# Kill focused window
bindsym $mod+Shift+q kill

# Launcher
bindsym $mod+d exec --no-startup-id rofi -show drun

# Focus
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split
bindsym $mod+h split h
bindsym $mod+v split v

# Fullscreen
bindsym $mod+f fullscreen toggle

# Layout
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Float
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# Wallpaper
exec --no-startup-id $HOME/bin/updateWallpaper.sh
bindsym $mod+Control+F9 exec $HOME/bin/updateWallpaper.sh

# Named workspaces
set $workspace1 "1 "
set $workspace2 "2 "
set $workspace10 "10 "

# Switch workspace
bindsym $mod+1 workspace $workspace1
bindsym $mod+2 workspace $workspace2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace $workspace10

bindsym $mod+Control+1 workspace 11
bindsym $mod+Control+2 workspace 12
bindsym $mod+Control+3 workspace 13
bindsym $mod+Control+4 workspace 14
bindsym $mod+Control+5 workspace 15
bindsym $mod+Control+6 workspace 16
bindsym $mod+Control+7 workspace 17
bindsym $mod+Control+8 workspace 18
bindsym $mod+Control+9 workspace 19
bindsym $mod+Control+0 workspace 20

# Move container to workspace
bindsym $mod+Shift+1 move container to workspace $workspace1
bindsym $mod+Shift+2 move container to workspace $workspace2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace $workspace10

bindsym $mod+Control+Shift+1 move container to workspace 11
bindsym $mod+Control+Shift+2 move container to workspace 12
bindsym $mod+Control+Shift+3 move container to workspace 13
bindsym $mod+Control+Shift+4 move container to workspace 14
bindsym $mod+Control+Shift+5 move container to workspace 15
bindsym $mod+Control+Shift+6 move container to workspace 16
bindsym $mod+Control+Shift+7 move container to workspace 17
bindsym $mod+Control+Shift+8 move container to workspace 18
bindsym $mod+Control+Shift+9 move container to workspace 19
bindsym $mod+Control+Shift+0 move container to workspace 20

# Move workspace to monitor
bindsym mod1+1 move workspace to output DP-2-1
bindsym mod1+2 move workspace to output DP-2-2
bindsym mod1+3 move workspace to output DP-2-8
bindsym mod1+4 move workspace to output eDP-1
bindsym mod1+5 move workspace to output HDMI2
bindsym mod1+6 move workspace to output DP-3
bindsym mod1+7 move workspace to output DP-4
bindsym mod1+8 move workspace to output DP-2
bindsym mod1+9 move workspace to output DVI-I-1-1
bindsym mod1+0 move workspace to output DVI-I-2-2

# Scratchpad
bindsym $mod+m move scratchpad
bindsym $mod+o scratchpad show

# Reload / restart / exit
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3? This will end your X session.' -b 'Yes, exit i3' 'i3-msg exit'"

# Resize mode
mode "resize" {
    bindsym j resize shrink width 10 px or 10 ppt
    bindsym k resize grow height 10 px or 10 ppt
    bindsym l resize shrink height 10 px or 10 ppt
    bindsym semicolon resize grow width 10 px or 10 ppt
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym b resize set 2000 1200
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# System mode
set $mode_system (j)iggle, (l)ock, (e)xit, switch_(u)ser, (s)uspend, (h)ibernate, (r)eboot, (Shift+s)hutdown
bindsym $mod+q mode "$mode_system"
mode "$mode_system" {
    bindsym j exec --no-startup-id jigglejiggle.sh, mode "default"
    bindsym l exec --no-startup-id $HOME/bin/i3exit lock, mode "default"
    bindsym s exec --no-startup-id $HOME/bin/i3exit suspend, mode "default"
    bindsym u exec --no-startup-id $HOME/bin/i3exit switch_user, mode "default"
    bindsym e exec --no-startup-id $HOME/bin/i3exit logout, mode "default"
    bindsym h exec --no-startup-id $HOME/bin/i3exit hibernate, mode "default"
    bindsym r exec --no-startup-id $HOME/bin/i3exit reboot, mode "default"
    bindsym Shift+s exec --no-startup-id $HOME/bin/i3exit shutdown, mode "default"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# KeePassXC scratchpad
bindsym $mod+Control+k [class="^KeePassXC"] scratchpad show
for_window [class="^KeePassXC$"] move scratchpad
for_window [class="^KeePassXC$" title="Generate Password$"] move scratchpad
for_window [class="^KeePassXC$" title="Generate Password$"] scratchpad show
for_window [class="^KeePassXC$" title="Setup TOTP$"] move scratchpad
for_window [class="^KeePassXC$" title="Setup TOTP$"] scratchpad show
for_window [class="^KeePassXC$" title="KeePassXC - Browser Access Request$"] move scratchpad
for_window [class="^KeePassXC$" title="KeePassXC - Browser Access Request$"] scratchpad show

# FortiClient scratchpad
bindsym $mod+Control+p [class="^FortiClient$"] scratchpad show
for_window [class="^FortiClient$"] move scratchpad

# Spotify scratchpad
bindsym $mod+Control+s [class="^Spotify$"] scratchpad show
for_window [class="^Spotify$"] move scratchpad

# Nemo scratchpad
bindsym $mod+Control+b [class="^Nemo$"] scratchpad show
for_window [class="^Nemo$"] move scratchpad

# AWS VPN scratchpad
bindsym $mod+Control+a [class="^AWS VPN Client$"] scratchpad show
for_window [class="^AWS VPN Client$"] move scratchpad

# assume-menu
bindsym $mod+a exec /usr/local/bin/assume-menu

# VS Code Insiders → workspace 3
for_window [class="^com\.microsoft\.VSCodeInsiders$"] move workspace 3
for_window [class="^Code - Insiders"] move workspace 3

# Outlook → workspace 4
for_window [class="outlook-for-linux"] move workspace 4

# Work chat apps → workspace 1 / 7
for_window [class="^teams-for-linux"] move workspace 7
for_window [class="^Slack"] move workspace $workspace1
for_window [class="^Mattermost"] move workspace $workspace1
for_window [class="^Hexchat"] move workspace 1

# Obsidian → workspace 9
for_window [class="^md\.obsidian\.Obsidian$"] move workspace 9

# DBeaver → workspace 5
for_window [class="^DBeaver"] move workspace 5

# Chromium → workspace 4
for_window [class="^Chromium"] move workspace 4

# Window icon padding
for_window [all] title_window_icon padding 11px

# Bar
bar {
    status_command py3status -c $HOME/.config/i3/i3status.conf
    position top
    font pango:monospace 9
    tray_output Primary
}

# Autolock (update lock image path to suit your setup)
exec xautolock -secure -corners "--++" -locker "$HOME/bin/lock" -time 5 &

# System tray
exec --no-startup-id nm-applet
exec --no-startup-id blueman-applet
exec --no-startup-id pa-applet
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# Work apps (comment out what you don't need)
exec --no-startup-id slack
exec --no-startup-id teams-for-linux
exec --no-startup-id outlook-for-linux
exec --no-startup-id mattermost-desktop

# Productivity
exec keepassxc
exec forticlient gui
exec obsidian
exec code-insiders
exec nemo
exec spotify
exec --no-startup-id gtk-launch awsvpnclient.desktop

# X init
exec xrdb $HOME/.Xresources

# Compositor
exec picom

# Screen lock via xss-lock
exec_always --no-startup-id pkill xss-lock; xss-lock --transfer-sleep-lock -- $HOME/bin/lock --nofork

# Screen layouts (update output names to match your hardware)
bindsym $mod+Control+F10 exec $HOME/.screenlayout/home.sh
bindsym $mod+Control+F11 exec $HOME/.screenlayout/office.sh
bindsym $mod+Control+F12 exec $HOME/.screenlayout/laptop.sh

# Screen utils
bindsym $mod+Control+F5 exec $HOME/bin/blackOut.sh
bindsym $mod+Control+F6 exec $HOME/bin/stayOn.sh
bindsym $mod+Control+F7 exec --no-startup-id brightnessctl set 5%

# Lock screen
bindsym $mod+F12 exec $HOME/bin/lock

# Audio
bindsym XF86AudioRaiseVolume exec --no-startup-id pamixer -i 5
bindsym XF86AudioLowerVolume exec --no-startup-id pamixer -d 5
bindsym XF86AudioMute        exec --no-startup-id pamixer -t
bindsym $mod+Home exec pamixer -t
bindsym $mod+Control+v exec pavucontrol

# Keyboard layouts
bindsym $mod+F8 exec setxkbmap -layout gb
bindsym $mod+F9 exec setxkbmap -layout dk
exec setxkbmap -layout gb

# Screen blanking off
exec xset s off
exec xset -dpms

# Monitor brightness
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

# Screenshot
bindsym Print exec flameshot gui

# Browser
bindsym $mod+Control+f exec firefox

# Clipboard typer
bindsym $mod+F1 exec $HOME/bin/typeclipboard.sh

# Media keys (playerctl works with Spotify and any other MPRIS player)
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous
bindsym XF86AudioStop exec --no-startup-id playerctl stop

# Fun sounds (update paths or remove)
bindsym $mod+Control+F1 exec --no-startup-id "mpg123 $HOME/Documents/du.maa.ikk.ryge.her.inde.bjarne.mp3"
bindsym $mod+Control+F2 exec --no-startup-id "mpg123 $HOME/Documents/ya.dun.goofed.mp3"
bindsym $mod+Control+F3 exec --no-startup-id "mpg123 $HOME/Documents/always.time.for.beer.mp3"

# No borders
new_window pixel 1
